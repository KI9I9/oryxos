{
  "name": "oryxos-website-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.1 <12"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "docs:dev": "vitepress dev --host 127.0.0.1",
    "docs:typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "preview:test": "npm run docs:build && vitepress preview --host 127.0.0.1 --port 4173",
    "assets:build": "node scripts/export-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "test:scripts": "node --test tests/scripts/check-content.test.mjs tests/scripts/verify-build.test.mjs tests/scripts/export-assets.test.mjs",
    "test:workflow-policy": "node --test tests/scripts/workflow-policy.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:release": "playwright test --project=chromium",
    "test:quality": "npm run test:scripts && npm run test:workflow-policy && npm run check:content && npm run assets:build && npm run assets:verify && npm run docs:typecheck && npm run docs:build && npm run verify:build && npm run test:e2e:ci"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9",
    "yaml": "2.9.0"
  }
}
